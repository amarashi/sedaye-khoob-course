PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

COURSE_SLUG=music-theory
COURSE_TITLE=دوره تئوری موسیقی
COURSE_PRICE=0
PAYMENT_CURRENCY=IRT

# Use "manual" until merchant credentials are ready. Use "zarinpal" for online payment.
PAYMENT_PROVIDER=manual
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Enable only after confirming the Spot Player API key and course ID.
# API key: Spot Player panel -> settings/API.
# Course IDs: run `npm run spotplayer courses` once SPOTPLAYER_API is set.
SPOTPLAYER_ENABLED=false
SPOTPLAYER_API=
# "test" issues non-billable test licences; anything else issues real ones.
SPOTPLAYER_MODE=test
# Comma-separated. All listed courses are bundled into one licence.
SPOTPLAYER_COURSE_IDS=
# Device limits, each 0-99. p0 caps total concurrent devices; the rest cap per platform (0 = no platform-specific cap).
SPOTPLAYER_ALLOWED_DEVICES=2
SPOTPLAYER_WINDOWS=0
SPOTPLAYER_MACOS=0
SPOTPLAYER_UBUNTU=0
SPOTPLAYER_ANDROID=0
SPOTPLAYER_IOS=0
SPOTPLAYER_WEBAPP=2
# Burned into the video. Placeholders: {name} {mobile} {email}
SPOTPLAYER_WATERMARK_TEMPLATE={name} | {mobile}

# Optional admin email notifications for new orders and payment status changes.
ADMIN_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
